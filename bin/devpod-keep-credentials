#!/usr/bin/env bash
# Keeps DevPod's git credentials working in a workspace while nobody is connected.
# DevPod's credential server lives only as long as the `devpod ssh` session that
# started it; agents in tmux outlive that session and lose git/gh auth. This holds
# a session open, and reconnects (starting a fresh server) whenever auth dies.
#   devpod-keep-credentials <workspace> &
set -u
ws=$1
probe='printf "protocol=https\nhost=github.com\n\n" | timeout 10 git credential fill 2>/dev/null | grep -q "^password="'
while true; do
  devpod ssh "$ws" --start-services=true --command "while ${probe}; do sleep 30; done" >/dev/null 2>&1
  sleep 5
done
